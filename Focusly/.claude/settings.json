{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh:*)",
      "Bash(./scripts/run.sh:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift format lint:*)",
      "Bash(swift package describe:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild -showBuildSettings:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-swift-code.sh"
          }
        ]
      }
    ]
  }
}
